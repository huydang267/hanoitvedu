# Copy to .env and fill in. Never commit .env.

# Signs the session cookie and the CSRF token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ProdConfig refuses to start while this is left at the dev default.
SECRET_KEY=

# SQLAlchemy connection string. Defaults to sqlite:///hanoitvedu.sqlite
# inside instance/ when unset.
DATABASE_URL=

# development | production
FLASK_ENV=development
